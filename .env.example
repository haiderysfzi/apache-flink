# Copy to .env (scripts do this automatically on first run). .env is git-ignored.
# DEV DEFAULTS ONLY - change before exposing anything beyond localhost.

POSTGRES_USER=flink
POSTGRES_PASSWORD=flink
POSTGRES_DB=flink

# CLICKHOUSE_DB must stay `flink` unless you also edit docker/clickhouse/init/01_schema.sql
CLICKHOUSE_USER=flink
CLICKHOUSE_PASSWORD=flink
CLICKHOUSE_DB=flink

# Host ports (all bound to 127.0.0.1)
FLINK_UI_PORT=8081
POSTGRES_PORT=5432
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# Flink sizing (total docker memory needed ~ JM + TM + ~1.5G for the databases)
JM_MEMORY=1024m
TM_MEMORY=1728m
TM_SLOTS=2
FLINK_PARALLELISM=2

# Job knobs
EVENTS_PER_SECOND=200
NUM_USERS=50
WINDOW_SECONDS=10
CHECKPOINT_INTERVAL_MS=10000
JDBC_BATCH_SIZE=1000
JDBC_BATCH_INTERVAL_MS=1000
